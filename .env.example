# ---------------------------------------------------------------------------
# The Mico University College — environment variables (placeholders)
# Copy this file to `.env.local` (Vite reads `.env.local` automatically) and
# fill in values. Do NOT commit real keys.
# ---------------------------------------------------------------------------

# Intended production URL — used for canonical links, Open Graph and the
# structured-data markup. Falls back to the current browser origin at runtime.
NEXT_PUBLIC_SITE_URL=https://www.mico.edu.jm
VITE_SITE_URL=https://www.mico.edu.jm

# WordPress headless CMS (REST API) — see README "Connect WordPress REST API"
WORDPRESS_API_URL=https://example.mico.edu.jm/wp-json
VITE_WORDPRESS_API_URL=https://example.mico.edu.jm/wp-json

# WordPress headless CMS (WPGraphQL) — see README "Connect WPGraphQL"
WORDPRESS_GRAPHQL_URL=https://example.mico.edu.jm/graphql
VITE_WORDPRESS_GRAPHQL_URL=https://example.mico.edu.jm/graphql

# Optional: bearer token if the REST API is protected
WORDPRESS_APPLICATION_PASSWORD=
VITE_WORDPRESS_APPLICATION_PASSWORD=
